PORT=3000

# Must match identity-service JWT_ACCESS_SECRET exactly
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters

# Downstream service URLs
IDENTITY_SERVICE_URL=http://localhost:3001/api/v1
SOCIAL_SERVICE_URL=http://localhost:3002/api/v1
CONTENT_SERVICE_URL=http://localhost:3003/api/v1
FEED_SERVICE_URL=http://localhost:3004/api/v1
CHAT_SERVICE_URL=http://localhost:3005/api/v1

# Rate limiting (requests per window)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
